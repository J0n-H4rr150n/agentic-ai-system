{
  "name": "Scenario 1: Autonomous Agent with Human Oversight",
  "description": "Agent loops through analysis steps, checks confidence, requires approval for low-confidence or high-risk actions",
  "nodes": [
    {
      "id": "input-url",
      "type": "input",
      "title": "Target URL Input",
      "x": 50,
      "y": 100,
      "config": {
        "label": "Target URL",
        "value": "http://localhost:10303/",
        "output_key": "target_url"
      }
    },
    {
      "id": "input-prompt",
      "type": "input",
      "title": "User Prompt Input",
      "x": 50,
      "y": 200,
      "config": {
        "label": "User Prompt",
        "value": "Find all login forms and extract their structure",
        "output_key": "user_prompt"
      }
    },
    {
      "id": "input-system",
      "type": "input",
      "title": "System Instructions",
      "x": 50,
      "y": 300,
      "config": {
        "label": "System Prompt",
        "value": "You are an expert web security analyst. Always output a confidence score between 0 and 1 reflecting your certainty. Be conservative with confidence - score below 0.5 if you're unsure. Output your reasoning clearly.",
        "output_key": "system_prompt"
      }
    },
    {
      "id": "loop-main",
      "type": "loop",
      "title": "Agent Loop",
      "x": 300,
      "y": 200,
      "config": {
        "workflow_id": "agent-loop-inner",
        "max_iterations": 10,
        "break_condition": "state.done === true || state.error === true"
      }
    },
    {
      "id": "llm-agent",
      "type": "llm",
      "title": "AI Agent Brain",
      "x": 500,
      "y": 200,
      "config": {
        "model": "gemini-2.5-pro",
        "system_prompt": "{{system_prompt}}",
        "prompt": "Target URL: {{target_url}}\n\nUser Goal: {{user_prompt}}\n\n{% if browser_output %}Latest Browser Output:\n{{browser_output}}\n{% endif %}\n\n{% if iteration > 1 %}Previous Findings:\n{{llm_findings}}{% endif %}\n\nAnalyze the situation and decide on the next action. Be conservative with confidence.",
        "output_schema": "{\n  \"response\": \"string\",\n  \"confidence\": \"number\",\n  \"action\": \"string\",\n  \"findings\": \"array\",\n  \"reasoning\": \"string\",\n  \"done\": \"boolean\"\n}",
        "json_mode": true
      }
    },
    {
      "id": "router-confidence",
      "type": "router",
      "title": "Check Confidence",
      "x": 700,
      "y": 200,
      "config": {
        "output_key": "router_decision",
        "default_output": "low_confidence",
        "conditions": [
          {
            "var": "llm_confidence",
            "op": "greater_equal",
            "value": 0.5,
            "output": "high_confidence"
          },
          {
            "var": "llm_confidence",
            "op": "less_than",
            "value": 0.5,
            "output": "low_confidence"
          }
        ]
      }
    },
    {
      "id": "approval-low-confidence",
      "type": "human_approval",
      "title": "Review Low Confidence Action",
      "x": 700,
      "y": 350,
      "config": {
        "title": "Low Confidence - Human Review Required",
        "message": "The AI agent has low confidence in its decision. Please review the proposed action.",
        "show_state_keys": "[\"llm_action\", \"llm_confidence\", \"llm_reasoning\", \"llm_findings\"]",
       "timeout_seconds": 300
      }
    },
    {
      "id": "router-tool",
      "type": "router",
      "title": "Select Tool",
      "x": 900,
      "y": 200,
      "config": {
        "output_key": "tool_selected",
        "default_output": "browser",
        "conditions": [
          {
            "var": "llm_action",
            "op": "equals",
            "value": "navigate",
            "output": "browser"
          },
          {
            "var": "llm_action",
            "op": "equals",
            "value": "screenshot",
            "output": "browser"
          },
          {
            "var": "llm_action",
            "op": "equals",
            "value": "http_request",
            "output": "http"
          },
          {
            "var": "llm_done",
            "op": "equals",
            "value": true,
            "output": "end"
          }
        ]
      }
    },
    {
      "id": "browser-tool",
      "type": "browser",
      "title": "Browser Tool",
      "x": 1100,
      "y": 150,
      "config": {
        "action": "{{llm_action}}",
        "url_key": "target_url",
        "observation_mode": "visual",
        "output_key": "browser_output"
      }
    },
    {
      "id": "http-tool",
      "type": "http_request",
      "title": "HTTP Tool",
      "x": 1100,
      "y": 280,
      "config": {
        "url": "{{target_url}}",
        "method": "GET",
        "output_key": "http_output"
      }
    },
    {
      "id": "end-workflow",
      "type": "end",
      "title": "Workflow Complete",
      "x": 1300,
      "y": 200,
      "config": {
        "result_key": "llm_findings"
      }
    }
  ],
  "wires": [
    {
      "from": "input-url",
      "to": "loop-main",
      "fromPort": "default",
      "toPort": "default"
    },
    {
      "from": "input-prompt",
      "to": "loop-main",
      "fromPort": "default",
      "toPort": "default"
    },
    {
      "from": "input-system",
      "to": "loop-main",
      "fromPort": "default",
      "toPort": "default"
    },
    {
      "from": "loop-main",
      "to": "llm-agent",
      "fromPort": "iteration",
      "toPort": "default"
    },
    {
      "from": "llm-agent",
      "to": "router-confidence",
      "fromPort": "default",
      "toPort": "default"
    },
    {
      "from": "router-confidence",
      "to": "approval-low-confidence",
      "fromPort": "low_confidence",
      "toPort": "default"
    },
    {
      "from": "router-confidence",
      "to": "router-tool",
      "fromPort": "high_confidence",
      "toPort": "default"
    },
    {
      "from": "approval-low-confidence",
      "to": "router-tool",
      "fromPort": "approved",
      "toPort": "default"
    },
    {
      "from": "approval-low-confidence",
      "to": "end-workflow",
      "fromPort": "rejected",
      "toPort": "default"
    },
    {
      "from": "router-tool",
      "to": "browser-tool",
      "fromPort": "browser",
      "toPort": "default"
    },
    {
      "from": "router-tool",
      "to": "http-tool",
      "fromPort": "http",
      "toPort": "default"
    },
    {
      "from": "router-tool",
      "to": "end-workflow",
      "fromPort": "end",
      "toPort": "default"
    },
    {
      "from": "browser-tool",
      "to": "loop-main",
      "fromPort": "default",
      "toPort": "continue"
    },
    {
      "from": "http-tool",
      "to": "loop-main",
      "fromPort": "default",
      "toPort": "continue"
    }
  ]
}
