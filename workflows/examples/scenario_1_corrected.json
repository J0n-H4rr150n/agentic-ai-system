{
    "graph": {
        "version": 1,
        "nodes": [
            {
                "id": "input-url",
                "type": "input",
                "title": "Target URL Input",
                "position": {
                    "x": 50,
                    "y": 100
                },
                "size": {
                    "width": 180,
                    "height": 100
                },
                "ports": [
                    {
                        "id": "default",
                        "kind": "output"
                    }
                ],
                "config": {
                    "label": "Target URL",
                    "value": "http://localhost:49784/",
                    "output_key": "target_url"
                }
            },
            {
                "id": "input-prompt",
                "type": "input",
                "title": "User Prompt Input",
                "position": {
                    "x": 50,
                    "y": 220
                },
                "size": {
                    "width": 180,
                    "height": 100
                },
                "ports": [
                    {
                        "id": "default",
                        "kind": "output"
                    }
                ],
                "config": {
                    "label": "User Prompt",
                    "value": "Find all login forms and extract their structure",
                    "output_key": "user_prompt"
                }
            },
            {
                "id": "input-system",
                "type": "input",
                "title": "System Instructions",
                "position": {
                    "x": 50,
                    "y": 340
                },
                "size": {
                    "width": 180,
                    "height": 120
                },
                "ports": [
                    {
                        "id": "default",
                        "kind": "output"
                    }
                ],
                "config": {
                    "label": "System Prompt",
                    "value": "You are an expert web security analyst. Always output a confidence score between 0 and 1 reflecting your certainty. Be conservative with confidence - score below 0.5 if you're unsure. Output your reasoning clearly.",
                    "output_key": "system_prompt"
                }
            },
            {
                "id": "llm-agent",
                "type": "llm",
                "title": "AI Agent Brain",
                "position": {
                    "x": 300,
                    "y": 200
                },
                "size": {
                    "width": 200,
                    "height": 120
                },
                "ports": [
                    {
                        "id": "default",
                        "kind": "input"
                    },
                    {
                        "id": "default",
                        "kind": "output"
                    }
                ],
                "config": {
                    "model": "gemini-2.5-pro",
                    "system_prompt": "{{system_prompt}}",
                    "prompt": "Target URL: {{target_url}}\n\nUser Goal: {{user_prompt}}\n\nAnalyze the situation and decide on the next action. If this is iteration 1, navigate to the URL. Otherwise recommend an action based on findings so far. Be conservative with confidence.",
                    "output_schema": "{\"response\": \"string\", \"confidence\": \"number\", \"action\": \"string\", \"findings\": \"array\", \"reasoning\": \"string\", \"done\": \"boolean\"}",
                    "json_mode": true
                }
            },
            {
                "id": "router-confidence",
                "type": "router",
                "title": "Check Confidence",
                "position": {
                    "x": 550,
                    "y": 200
                },
                "size": {
                    "width": 180,
                    "height": 100
                },
                "ports": [
                    {
                        "id": "default",
                        "kind": "input"
                    },
                    {
                        "id": "high_confidence",
                        "kind": "output"
                    },
                    {
                        "id": "low_confidence",
                        "kind": "output"
                    }
                ],
                "config": {
                    "output_key": "router_decision",
                    "default_output": "low_confidence",
                    "conditions": [
                        {
                            "var": "llm_confidence",
                            "op": "greater_equal",
                            "value": 0.5,
                            "output": "high_confidence"
                        }
                    ]
                }
            },
            {
                "id": "approval-low-confidence",
                "type": "human_approval",
                "title": "Review Low Confidence Action",
                "position": {
                    "x": 550,
                    "y": 350
                },
                "size": {
                    "width": 180,
                    "height": 120
                },
                "ports": [
                    {
                        "id": "default",
                        "kind": "input"
                    },
                    {
                        "id": "approved",
                        "kind": "output"
                    },
                    {
                        "id": "rejected",
                        "kind": "output"
                    }
                ],
                "config": {
                    "title": "Low Confidence - Human Review Required",
                    "message": "The AI agent has low confidence in its decision. Please review the proposed action.",
                    "show_state_keys": "[\"llm_action\", \"llm_confidence\", \"llm_reasoning\", \"llm_findings\"]",
                    "timeout_seconds": 300
                }
            },
            {
                "id": "end-workflow",
                "type": "end",
                "title": "Workflow Complete",
                "position": {
                    "x": 900,
                    "y": 260
                },
                "size": {
                    "width": 150,
                    "height": 80
                },
                "ports": [
                    {
                        "id": "default",
                        "kind": "input"
                    }
                ],
                "config": {
                    "result_key": "llm_findings"
                }
            }
        ],
        "edges": [
            {
                "id": "edge-1",
                "from": {
                    "nodeId": "input-url",
                    "portId": "default"
                },
                "to": {
                    "nodeId": "llm-agent",
                    "portId": "default"
                }
            },
            {
                "id": "edge-2",
                "from": {
                    "nodeId": "input-prompt",
                    "portId": "default"
                },
                "to": {
                    "nodeId": "llm-agent",
                    "portId": "default"
                }
            },
            {
                "id": "edge-3",
                "from": {
                    "nodeId": "input-system",
                    "portId": "default"
                },
                "to": {
                    "nodeId": "llm-agent",
                    "portId": "default"
                }
            },
            {
                "id": "edge-4",
                "from": {
                    "nodeId": "llm-agent",
                    "portId": "default"
                },
                "to": {
                    "nodeId": "router-confidence",
                    "portId": "default"
                }
            },
            {
                "id": "edge-5",
                "from": {
                    "nodeId": "router-confidence",
                    "portId": "low_confidence"
                },
                "to": {
                    "nodeId": "approval-low-confidence",
                    "portId": "default"
                }
            },
            {
                "id": "edge-6",
                "from": {
                    "nodeId": "approval-low-confidence",
                    "portId": "rejected"
                },
                "to": {
                    "nodeId": "end-workflow",
                    "portId": "default"
                }
            }
        ]
    }
}
